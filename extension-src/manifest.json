{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_extShortName__",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://github.com/nao-t-dev/Oct21-PHP-risk-inspector",
  "version": "0.1.0",
  "default_locale": "ja",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_extName__",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["webRequest", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "run_at": "document_idle",
      "all_frames": false,
      "css": ["content/highlight.css"],
      "js": [
        "vendor/tldts.min.js",
        "lib/advisories.js",
        "lib/version.js",
        "lib/link-rules.js",
        "lib/settings.js",
        "lib/i18n.js",
        "content/ui.css.js",
        "content/badge.js",
        "content/highlighter.js",
        "content/content.js"
      ]
    }
  ]
}
