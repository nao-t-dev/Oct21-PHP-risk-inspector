    "icons": "node develop/scripts/make-icons.mjs",
    "serve": "node develop/test/site/server.mjs",
    "zip": "node develop/scripts/package.mjs"
  },
  "devDependencies": {
    "@types/chrome": "0.3.4",
    "typescript": "6.0.3"
  }
}
